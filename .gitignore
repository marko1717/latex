# Ignore everything
*

# Whitelist directories
!generators/
!scripts/
!tex/
!overleaf-lessons/
!generated/
!generated/*/
!generated/**/*
!overleaf-lessons/*
!overleaf-lessons/extracted/*

# Whitelist files
!README.md
!CONTRIBUTING.md
!AI_PROMPT.md
!.gitignore
!nmt_database.json

# Whitelist topic directories with tasks (завдання.tex)
!*/
!*/завдання.tex
!*/завдання*.tex

# Whitelist Python scripts for answer randomization
!randomize_answers*.py

# Whitelist Python files in root (if any needed, but we prefer scripts/)
# !my_script.py

# Un-ignore contents of whitelisted directories
!generators/*
!scripts/*
!tex/*

# Explicitly ignore compiled/temp in whitelisted dirs (if standard pattern matches)
generators/__pycache__
scripts/__pycache__

# --- База НМТ 2023--2026 (новий формат) ---
!*.otf
!*/*.png
!*/*/завдання*.tex
!archive/
!archive/**
!# теку не ігноруємо цілком, інакше виняток для файла всередині не спрацює
scripts/data/*
!scripts/data/відповіді_*.json
!scripts/data/*.json
!/НМТ_2023-2026_всі_теми.tex
!/Розділ_*.tex
!/Показникові_*.tex

# локальні налаштування Claude Code
.claude/

# --- шаблон формату і скрипти звірки (у цьому .gitignore усе ігнорується за умовчанням) ---
!шаблон/
!шаблон/*
!scripts/*/
!scripts/*/*.py
!scripts/*/*.md

# --- не тримаємо в гілці main: Overleaf має ліміт на сумарний розмір текстових файлів ---
# Усе це є в гілці «джерела» на GitHub і лишається на диску локально.
archive/
scripts/data/*
# ключі відповідей маленькі й потрібні для збірки
!scripts/data/відповіді_*.json
generated/
tex/
generators/
analysis_2025/
digest_*.txt
nmt_database.json
*.zip

# PDF прикладу не тримаємо в git
шаблон/*.pdf
